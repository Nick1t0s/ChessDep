POSTGRES_USER=chessdep
POSTGRES_PASSWORD=change-me
POSTGRES_DB=chessdep
DATABASE_URL=postgresql+asyncpg://chessdep:change-me@postgres:5432/chessdep
REDIS_URL=redis://redis:6379/0
COOKIE_SECURE=false
ALLOWED_ORIGINS=http://localhost:8080
SESSION_TTL_DAYS=30
HTTP_PORT=8080
HTTPS_PORT=8443
# HTTPS: положите certs/fullchain.pem и certs/privkey.pem (для разработки: bash scripts/gen-dev-cert.sh),
# затем COOKIE_SECURE=true и добавьте https://<хост>:8443 в ALLOWED_ORIGINS.
